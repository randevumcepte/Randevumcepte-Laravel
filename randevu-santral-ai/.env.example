# ==== Randevu AI Santral kopru — ornek ayar (kopyala: cp .env.example .env) ====
# restaurant-santral-ai fork'u; randevumcepte beynine (RandevuAsistan) baglanir.

# --- Asterisk ARI (Asterisk 16/17) ---
# /etc/asterisk/ari.conf ve http.conf ile eslesmeli (README'ye bak)
ARI_URL=http://127.0.0.1:8088
ARI_USER=santral
ARI_PASS=degistir-bu-sifreyi
# Dialplan'de Stasis(...) ile cagrilan uygulama adi (eski sidecar 'randevu_ai' ile CAKISMASIN).
ARI_APP=randevu-santral-ai

# --- Bu koprunun RTP dinledigi yerel adres (Asterisk ile AYNI sunucu) ---
RTP_HOST=127.0.0.1
RTP_PORT_BASE=40200
RTP_PORT_COUNT=100

# Telefon sesi darbant: ulaw/8kHz native (yeniden orneklemesiz). Secenek: ulaw | slin16
MEDIA_FORMAT=ulaw

# --- Laravel beyin (RandevuAsistan) — DOMAIN KOKU (sonuna /api YAZMA; kopru /api/santral/... ekler) ---
LARAVEL_BASE_URL=https://apptest.randevumcepte.com.tr
# Hangi SALON ile calisilacak (restorandaki sube_id'nin randevu karsiligi). Dialplan SUBE= ile de gelebilir.
DEFAULT_SUBE_ID=1
# Kopru -> Laravel istekleri icin paylasilan sir (Laravel tarafinda X-Santral-Secret dogrulanir; opsiyonel).
SANTRAL_SECRET=

# --- Google STT (STREAMING = servis hesabi JSON gerekir, API anahtari YETMEZ) ---
# Mevcut calisan paylasimli anahtar (restoran ile ayni; STT yetkisi kanitli):
GOOGLE_APPLICATION_CREDENTIALS=/var/lib/asterisk/agi-bin/sesli-yanit/gcp-key.json
STT_LANGUAGE=tr-TR
# tr-TR icin 'latest_long'. DIKKAT: phone_call/video enhanced modeller tr-TR'de HIC sonuc dondurmez.
STT_MODEL=latest_long

# --- Google TTS (REST + API anahtari) ---
GOOGLE_TTS_API_KEY=
TTS_VOICE=tr-TR-Wavenet-E
TTS_SPEAKING_RATE=1.05

# --- Davranis ---
# BARGE_IN=1 (ONERILEN): tam-dupleks; musteri her an konusabilir, konusunca AI susar.
BARGE_IN=1
SESSIZLIK_MS=15000
LOG_LEVEL=info

# --- Ses kaydi (ARI bridge recording -> Laravel) ---
KAYIT_AKTIF=1
ASTERISK_RECORDING_DIR=/var/spool/asterisk/recording

# --- Terk edilen cagri kurtarma (otomatik geri arama) — OUTBOUND SART, varsayilan KAPALI ---
GERI_ARAMA=0
GERI_ARAMA_DIAL=
GERI_ARAMA_PREFIX=0
GERI_ARAMA_CALLERID=
GERI_ARAMA_TIMEOUT=30
GERI_ARAMA_POLL_SN=20

# --- Ofis ambiyansi (comfort noise, UCRETSIZ) ---
AMBIYANS=1
AMBIYANS_SEVIYE=0.12
# AMBIYANS_DOSYA=/opt/randevu-santral-ai/assets/ofis-ambiyans.sln
